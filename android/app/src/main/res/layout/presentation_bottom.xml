<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121410">

    <!-- Top Action Toolbar -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#181C16">

        <Button
            android:id="@+id/btnLoadApp"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1.3"
            android:layout_marginEnd="6dp"
            android:text="+ LOAD .APP"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#A2C88A"
            android:background="@drawable/retro_btn_bg" />

        <Button
            android:id="@+id/btnSaveNvram"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="0.9"
            android:layout_marginEnd="6dp"
            android:text="SAVE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#A2C88A"
            android:background="@drawable/retro_btn_bg" />

        <Button
            android:id="@+id/btnSpeed"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1.1"
            android:layout_marginEnd="6dp"
            android:text="1.0x"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#A2C88A"
            android:background="@drawable/retro_btn_bg" />

        <Button
            android:id="@+id/btnPalette"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1.0"
            android:layout_marginEnd="6dp"
            android:text="PALETTE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#A2C88A"
            android:background="@drawable/retro_btn_bg" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="0.8"
            android:text="RESET"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#C88A8A"
            android:background="@drawable/retro_btn_reset_bg" />

    </LinearLayout>

    <!-- Authentic Cybiko Keyboard -->
    <com.cybiko.emulator.CybikoKeyboardView
        android:id="@+id/keyboardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
