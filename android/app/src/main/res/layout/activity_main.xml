<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121410">

    <!-- Top Screen: Scaled 160x100 Cybiko LCD -->
    <com.cybiko.emulator.CybikoDisplayView
        android:id="@+id/displayView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Container: Single-screen mode toolbar & keyboard -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/mainToolbar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="#181C16">

            <Button
                android:id="@+id/btnMainLoadApp"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.3"
                android:layout_marginEnd="6dp"
                android:text="+ LOAD .APP"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#A2C88A"
                android:background="@drawable/retro_btn_bg" />

            <Button
                android:id="@+id/btnMainSaveNvram"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="SAVE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#A2C88A"
                android:background="@drawable/retro_btn_bg" />

            <Button
                android:id="@+id/btnMainPalette"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.1"
                android:layout_marginEnd="6dp"
                android:text="PALETTE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#A2C88A"
                android:background="@drawable/retro_btn_bg" />

            <Button
                android:id="@+id/btnMainReset"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="0.9"
                android:text="RESET"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#C88A8A"
                android:background="@drawable/retro_btn_reset_bg" />

        </LinearLayout>

        <com.cybiko.emulator.CybikoKeyboardView
            android:id="@+id/keyboardView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
